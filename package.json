{
  "name": "@anonympins/fingerprint",
  "version": "0.1.2",
  "description": "An HTTP(S) client mitigation and anti-bot protection library for Node.js/Express, based on digital fingerprinting and dynamic Proof-of-Work (PoW) challenges.",
  "main": "fingerprint.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run --reporter=verbose"
  },
  "files": [
    "fingerprint.js",
    "fingerprint.client.js",
    "fingerprint.builder.js",
    "pow.solver.js",
    "library.js",
    "redis-store.js",
    "mongodb-store.js",
    "sql-store.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonympins/fingerprint.git"
  },
  "keywords": [
    "fingerprint",
    "bot",
    "anti-bot",
    "security",
    "express",
    "middleware",
    "proof-of-work",
    "pow",
    "rate-limiting",
    "mitigation",
    "captcha",
    "dns"
  ],
  "author": "anonympins",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anonympins/fingerprint/issues"
  },
  "homepage": "https://github.com/anonympins/fingerprint#readme",
  "devDependencies": {
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "prom-client": "^15.1.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "ioredis": "^5.3.2",
    "knex": ">=3.0.0",
    "mongodb": "^6.3.0",
    "sqlite3": "^5.1.7"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "knex": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  }
}
