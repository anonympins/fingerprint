{
  "name": "@anonympins/fingerprint",
  "version": "0.3.1",
  "description": "Advanced anti-bot library for Node.js using multi-layer fingerprinting (JA3, client-side, headers), behavioral analysis, and adaptive Proof-of-Work (PoW) challenges to mitigate scraping, scalping, and automated threats.",
  "main": "fingerprint.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "build": "node build-client.js"
  },
  "files": [
    "fingerprint.js",
    "fingerprint.client.js",
    "fingerprint.client.obfuscated.js",
    "fingerprint.builder.js",
    "pow.solver.js",
    "pow.worker.js",
    "pow.solver.inline.js",
    "problem-manager.js",
    "optimization.worker.js",
    "library.js",
    "redis-store.js",
    "mongodb-store.js",
    "sql-store.js", 
    "public/fp.wasm",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonympins/fingerprint.git"
  },
  "keywords": [
    "anti-bot",
    "bot-detection",
    "security",
    "middleware",
    "express",
    "nodejs",
    "fingerprint",
    "device-fingerprinting",
    "ja3",
    "tls-fingerprinting",
    "proof-of-work",
    "pow",
    "useful-proof-of-work",
    "upow",
    "waf",
    "scraping",
    "scalping",
    "mitigation",
    "rate-limiting",
    "honeypot",
    "behavioral-analysis"
  ],
  "author": "anonympins",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anonympins/fingerprint/issues"
  },
  "homepage": "https://github.com/anonympins/fingerprint#readme",
  "devDependencies": {
    "body-parser": "^1.20.2",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "prom-client": "^15.1.2",
    "vitest": "^4.1.11",
    "javascript-obfuscator": "^4.1.0",
    "terser": "^5.30.3",
    "jsdom": "^24.0.0"
  },
  "peerDependencies": {
    "ioredis": "^5.3.2",
    "knex": ">=3.0.0",
    "mongodb": "^6.3.0",
    "sqlite3": "^5.1.7"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "knex": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  }
}
